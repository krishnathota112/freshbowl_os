# Copy this file to `.env.local` and fill in the three values.
#
#   cp .env.example .env.local
#
# `.env.local` is git-ignored and must stay that way — it carries a database password.

# ── The two the APP needs, to run ────────────────────────────────────────────
# Supabase dashboard → Project Settings → API
#
# The anon key is public by design. It is safe in the browser because every table
# has row-level security, and the role is a signed claim inside the access token —
# editing browser storage changes nothing.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...

# ── The one that MIGRATIONS AND TESTS need. Not needed just to run the app ───
# Supabase dashboard → Project Settings → Database → Connection string → URI
#
# Use the SESSION POOLER string, not the direct one: the direct host resolves to
# IPv6 only and will not connect from most laptops.
#
# The password must be PERCENT-ENCODED if it contains @ : / ? # [ ] or a space,
# otherwise the URI parses wrongly and the failure looks like a bad password.
#   @ → %40      : → %3A      / → %2F      # → %23
SUPABASE_DB_URL=postgresql://postgres.YOUR-PROJECT-REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
