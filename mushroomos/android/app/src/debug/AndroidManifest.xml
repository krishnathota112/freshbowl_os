<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug-variant manifest. The merger folds this into the main manifest for the
  debug build only; the release manifest never sees the attribute below, and
  therefore never references a network security config at all.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application android:networkSecurityConfig="@xml/network_security_config" />
</manifest>
