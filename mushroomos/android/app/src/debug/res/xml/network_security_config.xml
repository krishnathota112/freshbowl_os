<?xml version="1.0" encoding="utf-8"?>
<!--
  DEBUG BUILDS ONLY. This file lives in src/debug/ and is compiled into no other
  variant, so a release APK cannot contain it even by accident.

  WHY IT EXISTS
    The development machine runs Norton Antivirus with SSL/TLS scanning enabled.
    Norton terminates every HTTPS connection and re-issues it under its own root:

      issuer: CN=Norton Web/Mail Shield Root
              OU=generated by Norton Antivirus for SSL/TLS scanning

    Android does not trust that root, so every Supabase call from the emulator
    failed with net::ERR_CERT_AUTHORITY_INVALID and the app sat on "Loading...".

  WHAT IT DOES
    <debug-overrides> applies ONLY when the APK is android:debuggable, which the
    release build is not. Inside it we keep the full system trust store and ADD
    the interception root, so a debug build on this one machine can reach the
    server. Certificate validation is otherwise unchanged: this is not
    "trust everything", and no cleartext traffic is permitted anywhere.

  WHAT IT DELIBERATELY DOES NOT DO
    It does not trust user-installed CAs as a class, which would let anything a
    person taps "install" on become an authority. It names one certificate.
-->
<network-security-config>
    <debug-overrides>
        <trust-anchors>
            <certificates src="system" />
            <certificates src="@raw/debug_tls_interception_ca" />
        </trust-anchors>
    </debug-overrides>
</network-security-config>
